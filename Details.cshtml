@model Transaction
@{
    ViewData["Title"] = $"Transaction #{Model.TransactionId}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="display-heading mb-0">Transaction #@Model.TransactionId</h2>
    <a asp-controller="Transaction" asp-action="Index" class="btn btn-comic-secondary">&larr; Back to History</a>
</div>

<div class="comic-card p-4 mb-4">
    <p class="mb-1"><strong>Customer:</strong> @Model.CustomerName</p>
    @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
    {
        <p class="mb-1"><strong>Email:</strong> @Model.CustomerEmail</p>
    }
    <p class="mb-0"><strong>Date:</strong> @Model.Date.ToString("MMM d, yyyy h:mm tt")</p>
</div>

<div class="table-responsive panel-table mb-4">
    <table class="table table-borderless mb-0">
        <thead>
            <tr>
                <th>Item</th>
                <th>Qty</th>
                <th>Unit Price</th>
                <th>Line Total</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.PurchasedItems)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Quantity</td>
                <td>$@item.UnitPrice.ToString("0.00")</td>
                <td class="fw-bold">$@item.LineTotal.ToString("0.00")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="grand-total-banner">Total: $@Model.TotalAmount.ToString("0.00")</div>

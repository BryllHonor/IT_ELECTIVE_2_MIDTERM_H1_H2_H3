@model Transaction
@{
    ViewData["Title"] = "Sale Confirmed";
}

<div class="comic-card p-4 text-center mb-4">
    <span class="confirmation-stamp mb-3">SALE COMPLETE!</span>
    <h2 class="mt-3">Thanks, @Model.CustomerName!</h2>
    <p class="text-muted">Transaction #@Model.TransactionId &middot; @Model.Date.ToString("MMM d, yyyy h:mm tt")</p>
    @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
    {
        <p class="text-muted">Receipt on file for @Model.CustomerEmail</p>
    }
</div>

<div class="table-responsive panel-table mb-4">
    <table class="table table-borderless mb-0">
        <thead>
            <tr>
                <th>Item</th>
                <th>Qty</th>
                <th>Unit Price</th>
                <th>Line Total</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.PurchasedItems)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Quantity</td>
                <td>$@item.UnitPrice.ToString("0.00")</td>
                <td class="fw-bold">$@item.LineTotal.ToString("0.00")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="grand-total-banner">Total Paid: $@Model.TotalAmount.ToString("0.00")</div>
    <a asp-controller="Product" asp-action="Index" class="btn btn-comic-primary btn-lg">Start Next Sale &rarr;</a>
</div>

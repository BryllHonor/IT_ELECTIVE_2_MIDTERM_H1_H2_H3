@model List<Transaction>
@{
    ViewData["Title"] = "Sales History";
}

<h2 class="display-heading mb-3">Sales History</h2>

@if (Model.Count == 0)
{
    <div class="comic-card p-4 text-center">
        <h3>No sales recorded yet.</h3>
        <a asp-controller="Product" asp-action="Index" class="btn btn-comic-primary mt-2">Ring Up a Sale</a>
    </div>
}
else
{
    <div class="table-responsive panel-table">
        <table class="table table-borderless mb-0 align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Grand Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td class="fw-bold">#@t.TransactionId</td>
                    <td>@t.Date.ToString("MMM d, yyyy h:mm tt")</td>
                    <td>@t.CustomerName</td>
                    <td class="fw-bold">$@t.TotalAmount.ToString("0.00")</td>
                    <td>
                        <a asp-controller="Transaction" asp-action="Details" asp-route-id="@t.TransactionId"
                           class="btn btn-comic-secondary btn-sm">View Details</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
